<h1 class="heading-xl mb-6"><%= t('admin.panel.certificates') %></h1>
<%- include('../partials/admin-filters', {
  action: '/admin/certificates',
  search: { name: 'search', label: t('admin.common.search'), value: query.search },
  selects: [],
}) %>
<% if (result.items.length === 0) { %>
  <p class="text-text-muted"><%= t('admin.common.empty') %></p>
<% } else { %>
  <ul class="flex flex-col gap-3">
    <% for (const certificate of result.items) { %>
      <li class="card card-body flex flex-col gap-2">
        <div class="flex flex-wrap items-center gap-3">
          <a class="link font-mono font-semibold" href="/certificates/<%= certificate.code %>"><%= certificate.code %></a>
          <span><%= certificate.studentName %></span>
          <span class="text-text-muted"><%= certificate.courseTitle %> · <%= format.date(certificate.issuedAt) %></span>
          <span class="tag <%= certificate.revoked ? 'tag-red' : 'tag-green' %>"><%= certificate.revoked ? t('admin.certificates.revoked') : t('admin.certificates.valid') %></span>
        </div>
        <% if (certificate.revokedReason) { %><p class="text-sm text-text-muted"><%= t('admin.common.reason') %>: <%= certificate.revokedReason %></p><% } %>
        <% if (!certificate.revoked) { %>
          <details>
            <summary class="btn btn-outline btn-sm"><%= t('admin.certificates.revoke') %></summary>
            <div class="mt-3"><%- include('../partials/reason-form', { action: `/admin/certificates/${certificate.code}/revoke`, id: `revoke-${certificate.code}`, label: t('admin.common.reason'), button: t('admin.certificates.revoke'), returnTo: currentPath }) %></div>
          </details>
        <% } %>
      </li>
    <% } %>
  </ul>
  <%- include('../partials/pagination', { page: result.page, totalPages, hrefFor: pageHref }) %>
<% } %>
