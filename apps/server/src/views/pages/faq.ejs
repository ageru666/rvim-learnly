<section class="page-container max-w-3xl py-12">
  <h1 class="heading-xl mb-8"><%= heading %></h1>
  <div class="flex flex-col gap-3">
    <% for (const item of items) { %>
      <details class="card">
        <summary class="focus-ring cursor-pointer rounded-lg px-5 py-4 font-semibold"><%= item.question %></summary>
        <p class="border-t border-border px-5 py-4 text-text-muted"><%= item.answer %></p>
      </details>
    <% } %>
  </div>
</section>
