<%# Usage: include('../partials/video-embed', { embedUrl, title }) — embedUrl is built locally (contracts/video). %>
<div class="aspect-video w-full overflow-hidden rounded-lg bg-surface-sunken">
  <iframe
    src="<%= embedUrl %>"
    title="<%= title %>"
    class="h-full w-full"
    loading="lazy"
    allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen
  ></iframe>
</div>
