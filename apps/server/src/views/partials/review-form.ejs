<%#
  The user's review form (create or edit) or the reason why it is not available.
  Usage: include('../partials/review-form', { course, viewer, reviewForm }).
  The stars are real radio buttons: the form works without JavaScript; star-input.js only fills the stars.
%>
<% const myReview = viewer.myReview; %>
<% const selected = Number(reviewForm.values.rating) || 0; %>
<% if (viewer.canReview || myReview) { %>
  <div class="card card-body mb-6 flex flex-col gap-4">
    <h3 class="heading-md"><%= t('site.course.reviewForm.heading') %></h3>
    <% if (myReview && myReview.hidden) { %>
      <%- include('alert', { kind: 'warning', message: t('site.course.reviewForm.hiddenNotice') }) %>
    <% } %>
    <form method="post" action="/courses/<%= course.slug %>/reviews" class="flex flex-col gap-4" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <fieldset class="field" data-star-input <% if (reviewForm.errors.rating) { %>aria-describedby="review-rating-error"<% } %>>
        <legend class="field-label"><%= t('site.course.reviewForm.rating') %></legend>
        <div class="flex gap-1">
          <% for (const stars of [1, 2, 3, 4, 5]) { %>
            <label class="cursor-pointer rounded-sm p-0.5 has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-focus" data-star="<%= stars %>">
              <input type="radio" name="rating" value="<%= stars %>" class="sr-only" <% if (selected === stars) { %>checked<% } %> required />
              <span class="sr-only"><%= t('site.course.reviewForm.star', { count: stars }) %></span>
              <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" class="<%= stars <= selected ? 'text-accent-yellow' : 'text-border-strong' %>" data-star-icon>
                <path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/>
              </svg>
            </label>
          <% } %>
        </div>
        <% if (reviewForm.errors.rating) { %><p id="review-rating-error" class="field-error"><%= reviewForm.errors.rating %></p><% } %>
      </fieldset>
      <div class="field">
        <label class="field-label" for="review-text"><%= t('site.course.reviewForm.text') %></label>
        <textarea id="review-text" name="text" rows="4" class="input" aria-describedby="review-text-hint<%= reviewForm.errors.text ? ' review-text-error' : '' %>" <% if (reviewForm.errors.text) { %>aria-invalid="true"<% } %> required><%= reviewForm.values.text || '' %></textarea>
        <p id="review-text-hint" class="field-hint"><%= t('site.course.reviewForm.textHint') %></p>
        <% if (reviewForm.errors.text) { %><p id="review-text-error" class="field-error"><%= reviewForm.errors.text %></p><% } %>
      </div>
      <button type="submit" class="btn btn-primary self-start"><%= myReview ? t('site.course.reviewForm.update') : t('site.course.reviewForm.submit') %></button>
    </form>
    <% if (myReview) { %>
      <form method="post" action="/courses/<%= course.slug %>/reviews/delete" data-confirm="<%= t('site.course.reviewForm.deleteConfirm') %>" data-confirm-ok="<%= t('common.actions.delete') %>" data-confirm-cancel="<%= t('common.actions.cancel') %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="btn btn-ghost btn-sm"><%= t('site.course.reviewForm.delete') %></button>
      </form>
    <% } %>
  </div>
<% } else if (viewer.reviewBlockReason && viewer.enrolled) { %>
  <p class="mb-6 text-sm text-text-muted"><%= t(viewer.reviewBlockReason, { min: reviewMinProgress }) %></p>
<% } %>
