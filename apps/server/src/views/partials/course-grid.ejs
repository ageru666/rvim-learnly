<%# Usage: include('../partials/course-grid', { cards, headingLevel }) — headingLevel of the card titles, 3 by default. %>
<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  <% for (const card of cards) { %>
    <li><%- include('course-card', { card, headingLevel: locals.headingLevel }) %></li>
  <% } %>
</ul>
