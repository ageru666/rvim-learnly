# Non-secret values for the local test database (learnly_test). Loaded when NODE_ENV=test.
DATABASE_URL=postgresql://learnly:learnly@localhost:5433/learnly_test
DATABASE_URL_TEST=postgresql://learnly:learnly@localhost:5433/learnly_test
PORT=3100
APP_URL=http://localhost:3100
SPA_DEV_URL=
JWT_SECRET=test-only-jwt-secret-0123456789abcdef0123456789
COOKIE_SECURE=false
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Learnly <no-reply@learnly.local>"
UPLOADS_DIR=uploads-test
LOG_LEVEL=silent
RATE_LIMIT_GLOBAL_PER_MIN=100000
RATE_LIMIT_AUTH_PER_MIN=100000
