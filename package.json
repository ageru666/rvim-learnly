{
  "name": "learnly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Learnly, a bilingual mini-LMS (labs 1-3)",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w @learnly/server\" \"npm run dev -w @learnly/web\"",
    "build": "npm run build -w @learnly/contracts -w @learnly/i18n && npm run build -w @learnly/server -w @learnly/web",
    "start": "npm run start -w @learnly/server",
    "prod:build": "docker build --target build -t learnly:build . && docker build -t learnly:local .",
    "prod:up": "docker compose -f docker-compose.prod.yml up -d",
    "prod:down": "docker compose -f docker-compose.prod.yml down",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:server": "npm run test -w @learnly/server",
    "e2e": "npm run e2e -w @learnly/web",
    "test:postman": "node scripts/postman.mjs",
    "perf": "node scripts/perf.mjs",
    "check:strings": "node scripts/check-ejs-strings.mjs",
    "check:deps": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow \"MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;BlueOak-1.0.0;CC0-1.0;CC-BY-4.0;Unlicense;Python-2.0;OFL-1.1\" --summary && npm audit --omit=dev --audit-level=high",
    "check:bundle": "node scripts/bundle-budget.mjs",
    "knip": "knip",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:strings && npm run check:deps",
    "check:full": "npm run check && npm run knip && npm run e2e && npm run test:postman && npm run perf",
    "db:migrate": "npm run db:migrate -w @learnly/server",
    "db:seed": "npm run db:seed -w @learnly/server",
    "db:reset": "npm run db:reset -w @learnly/server",
    "db:setup": "node scripts/db-setup.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "knip": "^6.43.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "pg": "8.23.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.5.1": true,
    "unrs-resolver@1.12.2": true,
    "@scarf/scarf": false
  }
}
