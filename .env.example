# Local development defaults. Every value here is non-secret and works with docker-compose.yml.
# Copy to .env (`cp .env.example .env`); never commit .env.

DATABASE_URL=postgresql://learnly:learnly@localhost:5433/learnly

PORT=3000
# Public base URL used in emails and redirects. In development this is the Vite single entry point;
# in production set it to the server URL (e.g. http://localhost:3000).
APP_URL=http://localhost:5173
# Vite dev server; leave empty in production.
SPA_DEV_URL=http://localhost:5173

# Development-only placeholder. Use a long random value in any shared environment.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
COOKIE_SECURE=false

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Learnly <no-reply@learnly.local>"

UPLOADS_DIR=uploads
LOG_LEVEL=info

RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AUTH_PER_MIN=10
