{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["newman"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"]
    },
    "packages/contracts": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/i18n": {
      "entry": ["src/*.ts", "src/messages/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/design-tokens": {
      "entry": [],
      "ignoreDependencies": [
        "@fontsource-variable/inter",
        "@fontsource-variable/roboto-condensed",
        "@fontsource/jetbrains-mono"
      ]
    },
    "apps/server": {
      "entry": ["prisma.config.ts"],
      "project": ["src/**/*.ts", "prisma/**/*.ts", "tests/**/*.ts"],
      "ignore": ["src/generated/**"],
      "ignoreDependencies": [
        "@prisma/client",
        "ejs",
        "@types/ejs",
        "pino-pretty",
        "@learnly/design-tokens",
        "tailwindcss"
      ]
    },
    "apps/web": {
      "entry": ["src/index.tsx"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@learnly/design-tokens", "tailwindcss"]
    }
  }
}
