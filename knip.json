{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"]
    },
    "packages/contracts": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/i18n": {
      "entry": ["src/*.ts", "src/messages/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/design-tokens": {
      "entry": [],
      "ignoreDependencies": [
        "@fontsource-variable/inter",
        "@fontsource-variable/roboto-condensed",
        "@fontsource/jetbrains-mono"
      ]
    },
    "apps/server": {
      "project": ["src/**/*.ts", "prisma/**/*.ts", "tests/**/*.ts"],
      "ignoreDependencies": ["@prisma/client", "pino-pretty"]
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
